NODE_ENV=development
PORT=3000

# Supabase project settings. Never commit the service-role key itself.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=replace-with-anon-key
SUPABASE_SERVICE_ROLE_KEY=replace-with-service-role-key

# Generate each value independently with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-secret
JWT_REFRESH_SECRET=replace-with-a-different-long-random-secret
ENCRYPTION_KEY=replace-with-a-long-random-secret

CORS_ORIGINS=http://localhost:3001,http://localhost:3002
ADMIN_EMAILS=owner@example.com
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
LOG_LEVEL=info
EZ_PROXY_API_BASE_URL=https://api.ez-proxy.net/v1
# Store the provider token only in Railway/server secrets; never commit it.
EZ_PROXY_API_TOKEN=
EZ_PROXY_TIMEOUT_MS=20000

# Server 2: Proxy-Cheap REST API. Obtain both values from the provider API keys page.
PROXY_CHEAP_API_BASE_URL=https://api.proxy-cheap.com/v2
PROXY_CHEAP_API_KEY=
PROXY_CHEAP_API_SECRET=
PROXY_CHEAP_TIMEOUT_MS=20000

# Server 3: Proxy-Seller API v2. The API key is placed in the provider URL path by the backend.
PROXY_SELLER_API_BASE_URL=https://proxy-seller.com/personal/api/v2
PROXY_SELLER_API_KEY=
PROXY_SELLER_TIMEOUT_MS=20000

# Automatic Syriatel Cash / ShamCash verification. Keep secrets only in Railway.
SYRIATEL_API_BASE_URL=https://apisyria.com/api/v1
SYRIATEL_API_TOKEN=
SYRIATEL_API_QUERY=
SYRIATEL_API_TIMEOUT_MS=12000

# Automatic USDT payments through OxaPay. The webhook URL must be public HTTPS.
OXAPAY_API_BASE=https://api.oxapay.com/v1
OXAPAY_MERCHANT_API_KEY=
OXAPAY_WEBHOOK_URL=https://your-domain.example/api/v1/payments/oxapay/webhook
OXAPAY_FEE_PAID_BY_PAYER=1
OXAPAY_API_TIMEOUT_MS=12000
